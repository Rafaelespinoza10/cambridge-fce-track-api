{
  "name": "cambridge-fce-track-api",
  "version": "1.0.0",
  "description": "Serverless aws-nodejs-typescript template",
  "main": "serverless.ts",
  "scripts": {
    "build": "tsc --noEmit",
    "package": "serverless package",
    "package:dev": "serverless package --stage dev",
    "deploy": "serverless deploy",
    "deploy:dev": "serverless deploy --stage dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:test-connection": "node scripts/test-connection.js",
    "db:migration:generate": "node scripts/db.js migration:generate src/migrations/Migration -d src/config/database.ts",
    "db:migration:create": "node scripts/db.js migration:create src/migrations/Migration",
    "db:migration:run": "node scripts/db.js migration:run -d src/config/database.ts",
    "db:migration:revert": "node scripts/db.js migration:revert -d src/config/database.ts",
    "db:migration:show": "node scripts/db.js migration:show -d src/config/database.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@middy/core": "^3.4.0",
    "@middy/http-json-body-parser": "^3.4.0",
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.29"
  },
  "devDependencies": {
    "@serverless/typescript": "^3.0.0",
    "@types/aws-lambda": "^8.10.71",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^14.14.25",
    "@types/pg": "^8.20.0",
    "esbuild": "^0.14.11",
    "json-schema-to-ts": "^1.5.0",
    "prettier": "^3.8.3",
    "serverless": "^3.0.0",
    "serverless-esbuild": "^1.23.3",
    "ts-node": "^10.4.0",
    "tsconfig-paths": "^3.9.0",
    "typescript": "^4.1.3"
  },
  "author": "The serverless webpack authors (https://github.com/elastic-coders/serverless-webpack)",
  "license": "MIT"
}
